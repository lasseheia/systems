{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "rangeStrategy": "pin",
  "pinDigests": true,
  "nix": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "argocd": {
    "managerFilePatterns": [
      "/^hosts/server/incus/instances/kubernetes/manifests/.*\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["argocd"],
      "matchDatasources": ["git-tags", "helm"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^hosts/server/incus/opentofu/.*\\.tf$/"
      ],
      "matchStrings": [
        "remote\\s*=\\s*\"docker\"\\s+name\\s*=\\s*\"(?<depName>[^\"@]+?):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^hosts/server/incus/opentofu/.*\\.tf$/"
      ],
      "matchStrings": [
        "remote\\s*=\\s*\"github\"\\s+name\\s*=\\s*\"(?<depName>[^\"@]+?):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://ghcr.io"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am"
    ]
  }
}
